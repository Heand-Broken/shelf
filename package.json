{
  "name": "shelf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shelf / 拾页 - local-first read later and web clipper",
  "scripts": {
    "build": "node build.mjs",
    "build:firefox": "node build.mjs --target=firefox",
    "build:all": "node build.mjs && node build.mjs --target=firefox",
    "dev": "node build.mjs --watch",
    "pack": "node scripts/pack.mjs",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "dexie": "^4.4.7",
    "turndown": "^7.2.5"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/turndown": "^5.0.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
